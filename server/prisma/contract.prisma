// use prisma-8

enum Role {
  ADMIN
  MODERATOR
  CUSTOMER
  SUPPLIER
}

model Auth {
  id Uuid @id @onCreate(uuid())
  email String @unique
  password String
  refreshToken String?
  expiredAt DateTime @default(now())
  user User?
  @@index([refreshToken])
}

model User {
  id Uuid @id @onCreate(uuid())
  name String
  role Role @default(CUSTOMER)
  createdAt DateTime @default(now())
  archived Boolean @default(false)
  auth Auth @relation(fields: [authId], references: [id])
  authId Uuid @unique
  @@index([authId])
}

model Address {
  id Uuid @id @onCreate(uuid())
  state String
  city String
  address String
  active Boolean @default(false)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  userId Uuid
  @@index([userId])
}

type Dimensions {
  length Int
  width Int
  height Int
  weight Int
}

model Carton {
  id Uuid @id @onCreate(uuid())
  units Int
  dimensions Dimensions
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId Uuid @unique
}

model Product {
  id Uuid @id @onCreate(uuid())
  name String @unique
  slug String @unique
  sku String? @unique
  dimensions Dimensions?
  carton Carton?
  createdAt DateTime @default(now())
  archived Boolean @default(false)
}

enum OrderStatus {
  PENDING
  DELIVERING
  CANCELLED
  COMPLETED
}

type OrderAddress {
  state String
  city String
  address String
}

model Order {
  id Uuid @id @onCreate(uuid())
  status OrderStatus @default(PENDING)
  createdAt DateTime @default(now())
  address OrderAddress
  user User? @relation(fields: [userId], references: [id])
  userId Uuid?
}

model OrderItem {
  id Uuid @id @onCreate(uuid())
  price Int
  amount Int
  product Product @relation(fields: [productId], references: [id])
  productId Uuid
  order Order @relation(fields: [orderId], references: [id])
  orderId Uuid
  @@index([orderId])
}

enum OperationType {
  INBOUND
  RETURN
  OUTBOUND
  ADJUSTMENT
}

enum OperationStatus {
  COMPLETED
  CANCELLED
}

model Operation {
  id Uuid @id @onCreate(uuid())
  type OperationType
  status OperationStatus @default(COMPLETED)
  createdAt DateTime @default(now())
  order Order? @relation(fields: [orderId], references: [id])
  orderId Uuid?
}

model Transaction {
  id Uuid @id @onCreate(uuid())
  amount Int
  createdAt DateTime @default(now())
  operation Operation @relation(fields: [operationId], references: [id])
  operationId Uuid
  product Product @relation(fields: [productId], references: [id])
  productId Uuid
  @@index([operationId])
}